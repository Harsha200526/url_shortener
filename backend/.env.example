# ===========================================
# URL Shortener Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB connection string
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# For local MongoDB: mongodb://localhost:27017/url_shortener
MONGO_URI=mongodb://localhost:27017/url_shortener

# JWT secret key (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this

# JWT token expiry duration
JWT_EXPIRE=30d

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Base URL for short links (your backend URL)
BASE_URL=http://localhost:5000

# Node environment
NODE_ENV=development
